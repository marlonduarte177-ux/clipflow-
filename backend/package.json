{
  "name": "@clipflow/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de ClipFlow (Fastify).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clipflow/shared": "*",
    "@fastify/cors": "^11.3.0",
    "aws-jwt-verify": "^5.2.1",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "vitest": "^5.0.1"
  }
}
