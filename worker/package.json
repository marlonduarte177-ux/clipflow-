{
  "name": "@clipflow/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Procesador de video de ClipFlow (FFmpeg + SQS).",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/client-sqs": "^3.1143.0",
    "@aws-sdk/lib-storage": "^3.1143.0",
    "@clipflow/shared": "*",
    "drizzle-orm": "^0.45.3",
    "onnxruntime-node": "^1.30.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "vitest": "^5.0.1"
  }
}
