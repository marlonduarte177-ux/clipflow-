# =============================================================================
# ClipFlow — variables de entorno (PLANTILLA, sin secretos)
# =============================================================================
# DESARROLLO (tu computadora):
#   1. Copia este archivo:   cp .env.example .env
#   2. Rellena los valores vacíos. El archivo .env está en .gitignore y NUNCA
#      se sube a GitHub.
#
# STAGING / PRODUCCIÓN (AWS):
#   NO se usan archivos .env. Los valores los pone AWS CDK automáticamente
#   en los contenedores (ECS) y en Amplify. Los secretos (contraseña de la BD,
#   clave de OpenAI) viven en AWS Secrets Manager.
#
# Credenciales de AWS: NUNCA van aquí. En tu computadora se usa un perfil de
# AWS CLI (AWS_PROFILE); en AWS cada servicio usa un rol IAM.
#
# Variables NEXT_PUBLIC_*: se envían al navegador. Por eso JAMÁS deben
# contener secretos (los IDs de Cognito y la URL de la API no lo son).
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# Entorno actual: development | staging | production
APP_ENV=development
# Región de AWS donde viven todos los recursos.
AWS_REGION=us-east-1
# Perfil de AWS CLI en tu computadora (solo desarrollo). Ver docs de Fase 3.
AWS_PROFILE=clipflow-dev
# Nivel de logs: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# -----------------------------------------------------------------------------
# Local: coincide con docker-compose.yml (credenciales solo locales).
# AWS: ver DB_* abajo (la contraseña viene de Secrets Manager).
DATABASE_URL=postgres://clipflow:clipflow_local@localhost:5432/clipflow
# "true" en AWS (RDS exige conexión cifrada). En local: false.
DATABASE_SSL=false
# Base SOLO para tests automáticos: se BORRA en cada test (debe terminar en _test).
TEST_DATABASE_URL=postgres://clipflow:clipflow_local@localhost:5432/clipflow_test
# En AWS no se usa DATABASE_URL: CDK entrega DB_HOST, DB_PORT, DB_NAME y, desde
# Secrets Manager, DB_USER y DB_PASSWORD. No los definas en local.
# Aplicar migraciones pendientes al arrancar la API (true en AWS).
RUN_MIGRATIONS_ON_START=false

# -----------------------------------------------------------------------------
# Almacenamiento (S3)
# -----------------------------------------------------------------------------
# Nombre del bucket privado (lo muestra CDK al desplegar el entorno dev).
S3_BUCKET=
# Validez de las URLs firmadas, en segundos (se piden por lotes durante la subida).
S3_UPLOAD_URL_EXPIRES_SECONDS=3600
S3_DOWNLOAD_URL_EXPIRES_SECONDS=900

# -----------------------------------------------------------------------------
# Cola de trabajos (SQS)
# -----------------------------------------------------------------------------
# URL de la cola (la muestra CDK al desplegar). Formato:
# https://sqs.us-east-1.amazonaws.com/<ID_CUENTA>/<NOMBRE_COLA>
SQS_QUEUE_URL=

# -----------------------------------------------------------------------------
# Autenticación (Cognito) — no son secretos
# -----------------------------------------------------------------------------
# Usados por la API para validar tokens.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Los mismos valores, expuestos al navegador para el login.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=4000
# Orígenes que pueden llamar a la API (separados por comas).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# URL de la API que usa el frontend.
NEXT_PUBLIC_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Límites de upload
# -----------------------------------------------------------------------------
# Tamaño máximo por video en bytes (10 GB).
UPLOAD_MAX_BYTES=10737418240
# Duración máxima por video en segundos (3 h).
UPLOAD_MAX_DURATION_SECONDS=10800
# Tipos MIME permitidos (el worker además verifica el contenido real con ffprobe).
UPLOAD_ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/webm,video/x-matroska
# Subidas sin terminar que un usuario puede tener a la vez.
UPLOAD_MAX_PENDING=3

# -----------------------------------------------------------------------------
# Worker de video
# -----------------------------------------------------------------------------
# Carpeta temporal para trabajar con los archivos.
WORKER_TMP_DIR=/tmp/clipflow
# Ruta del ejecutable de FFmpeg / ffprobe.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Duraciones de clip permitidas en segundos (sobrescribe el valor por defecto).
CLIP_DURATIONS_SECONDS=15,30,45,60,90
# Duración usada si no se elige otra (debe estar en la lista de arriba).
DEFAULT_CLIP_DURATION_SECONDS=30
# Score mínimo 0–1 (relativo a cada video) para crear un clip, y máximo de clips por video.
MIN_CLIP_SCORE=0.6
MAX_CLIPS_PER_VIDEO=15
# Pesos del score (se normalizan entre las señales disponibles).
SCORE_WEIGHT_AUDIO=0.2
SCORE_WEIGHT_SPEECH=0.35
SCORE_WEIGHT_VISUAL=0.15
SCORE_WEIGHT_OCR=0.05
SCORE_WEIGHT_REACTION=0.1
SCORE_WEIGHT_ACTION=0.3
SCORE_WEIGHT_VISION=0.35
SCORE_WEIGHT_CHAT=0.4
# Segundos que un trabajo queda oculto a otros workers (se renueva mientras se procesa).
SQS_VISIBILITY_SECONDS=300
# Costo estimado por hora del worker (para medir rentabilidad; Fargate 2 vCPU/4 GB x86).
WORKER_COST_PER_HOUR_USD=0.0987

# -----------------------------------------------------------------------------
# Análisis de IA
# -----------------------------------------------------------------------------
# Proveedor activo: openai | none. Sin clave válida, el worker procesa solo con FFmpeg
# (y la web lo indica: "Sin análisis de IA").
AI_PROVIDER=openai
# Clave de OpenAI — SOLO en tu archivo .env local (nunca en .env.example, nunca en
# GitHub, nunca en el chat). En AWS la inyecta ECS desde Secrets Manager
# (secreto clipflow-<entorno>/openai-api-key); ahí es donde se pega.
OPENAI_API_KEY=
# Modelos. Solo whisper-1 devuelve tiempos por frase (necesarios para subtítulos y cortes).
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
# Límite de seguridad: minutos máximos de audio que se envían por video.
OPENAI_MAX_AUDIO_MINUTES=180
# Análisis de imágenes con IA (experimental: cuesta por imagen). Toma 1 fotograma cada
# AI_VISION_INTERVAL_SECONDS, los agrupa de a 9 por imagen y la IA puntúa cada uno.
AI_VISION_ENABLED=false
AI_VISION_INTERVAL_SECONDS=3
# Tope de fotogramas por video (en videos largos se espacian más).
AI_VISION_MAX_FRAMES=600
# Modelo con visión; vacío = el mismo de OPENAI_ANALYSIS_MODEL (y sus precios).
OPENAI_VISION_MODEL=

# Encuadre vertical que sigue a quien habla (o al grupo). Detector de caras local (YuNet con
# onnxruntime, en CPU): no llama a ninguna API ni tiene costo por imagen. "false" lo apaga y se
# usa el encuadre por acción.
FACE_TRACKING_ENABLED=true

# Precios para estimar el costo (USD). Revisar en https://openai.com/api/pricing
OPENAI_TRANSCRIBE_COST_PER_MINUTE_USD=0.006
OPENAI_INPUT_COST_PER_1M_TOKENS_USD=0.15
OPENAI_CACHED_INPUT_COST_PER_1M_TOKENS_USD=0.075
OPENAI_OUTPUT_COST_PER_1M_TOKENS_USD=0.6
# Versión del análisis (docs/analisis-v2.md): "classic" (actual) o "v2" (gpt-6.1-sol que además oye
# risas/gritos/aplausos/vítores con YAMNet local y ve un fotograma cada 5–10 s).
AI_PIPELINE=classic
OPENAI_V2_MODEL=gpt-6.1-sol
OPENAI_V2_REASONING_EFFORT=medium
OPENAI_V2_INPUT_COST_PER_1M_TOKENS_USD=2
OPENAI_V2_CACHED_INPUT_COST_PER_1M_TOKENS_USD=0.1
OPENAI_V2_OUTPUT_COST_PER_1M_TOKENS_USD=10
AI_V2_FRAME_MIN_SECONDS=5
AI_V2_FRAME_MAX_SECONDS=10
SOUND_DETECTION_ENABLED=true

# --- Pagos con Paddle (ver docs/pagos-paddle.md). Vacío/false = se procesa sin plan. ---
BILLING_ENABLED=false
BILLING_FREE_EMAILS=
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_TRIAL_FEE=
PADDLE_PRICE_BASIC=
PADDLE_PRICE_PRO=
PADDLE_PRICE_MAX=
PADDLE_PORTAL_URL=
# Secreta: en AWS va en Secrets Manager. Aquí solo para pruebas locales (nunca la subas a GitHub).
PADDLE_WEBHOOK_SECRET=
