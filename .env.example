# =============================================================================
# ClipFlow — variables de entorno (PLANTILLA, sin secretos)
# =============================================================================
# DESARROLLO (tu computadora):
#   1. Copia este archivo:   cp .env.example .env
#   2. Rellena los valores vacíos. El archivo .env está en .gitignore y NUNCA
#      se sube a GitHub.
#
# STAGING / PRODUCCIÓN (AWS):
#   NO se usan archivos .env. Los valores los pone AWS CDK automáticamente
#   en los contenedores (ECS) y en Amplify. Los secretos (contraseña de la BD,
#   clave de OpenAI) viven en AWS Secrets Manager.
#
# Credenciales de AWS: NUNCA van aquí. En tu computadora se usa un perfil de
# AWS CLI (AWS_PROFILE); en AWS cada servicio usa un rol IAM.
#
# Variables NEXT_PUBLIC_*: se envían al navegador. Por eso JAMÁS deben
# contener secretos (los IDs de Cognito y la URL de la API no lo son).
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# Entorno actual: development | staging | production
APP_ENV=development
# Región de AWS donde viven todos los recursos.
AWS_REGION=us-east-1
# Perfil de AWS CLI en tu computadora (solo desarrollo). Ver docs de Fase 3.
AWS_PROFILE=clipflow-dev
# Nivel de logs: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# -----------------------------------------------------------------------------
# Local: coincide con docker-compose.yml (credenciales solo locales).
# AWS: la API y el worker la construyen desde Secrets Manager (DB_SECRET_ARN).
DATABASE_URL=postgres://clipflow:clipflow_local@localhost:5432/clipflow
# Solo en AWS (lo pone CDK). Déjalo vacío en local.
DB_SECRET_ARN=

# -----------------------------------------------------------------------------
# Almacenamiento (S3)
# -----------------------------------------------------------------------------
# Nombre del bucket privado (lo muestra CDK al desplegar el entorno dev).
S3_BUCKET=
# Validez de las URLs firmadas, en segundos.
S3_UPLOAD_URL_EXPIRES_SECONDS=3600
S3_DOWNLOAD_URL_EXPIRES_SECONDS=900

# -----------------------------------------------------------------------------
# Cola de trabajos (SQS)
# -----------------------------------------------------------------------------
# URL de la cola (la muestra CDK al desplegar). Formato:
# https://sqs.us-east-1.amazonaws.com/<ID_CUENTA>/<NOMBRE_COLA>
SQS_QUEUE_URL=

# -----------------------------------------------------------------------------
# Autenticación (Cognito) — no son secretos
# -----------------------------------------------------------------------------
# Usados por la API para validar tokens.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Los mismos valores, expuestos al navegador para el login.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=4000
# Orígenes que pueden llamar a la API (separados por comas).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# URL de la API que usa el frontend.
NEXT_PUBLIC_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Límites de upload
# -----------------------------------------------------------------------------
# Tamaño máximo por video en bytes (10 GB).
UPLOAD_MAX_BYTES=10737418240
# Duración máxima por video en segundos (3 h).
UPLOAD_MAX_DURATION_SECONDS=10800
# Tipos MIME permitidos (el worker además verifica el contenido real con ffprobe).
UPLOAD_ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/webm,video/x-matroska

# -----------------------------------------------------------------------------
# Worker de video
# -----------------------------------------------------------------------------
# Carpeta temporal para trabajar con los archivos.
WORKER_TMP_DIR=/tmp/clipflow
# Ruta del ejecutable de FFmpeg / ffprobe.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Duraciones de clip permitidas en segundos (sobrescribe el valor por defecto).
CLIP_DURATIONS_SECONDS=15,30,45,60,90

# -----------------------------------------------------------------------------
# Análisis de IA
# -----------------------------------------------------------------------------
# Proveedor activo: openai | mock (mock solo para tests / desarrollo sin clave).
AI_PROVIDER=openai
# Clave de OpenAI — SOLO en tu archivo .env local (nunca en .env.example,
# nunca en GitHub, nunca en el chat). En AWS no se usa esta variable: la clave
# vive en Secrets Manager y el worker la lee con OPENAI_SECRET_ARN.
OPENAI_API_KEY=
# Solo en AWS (lo pone CDK). Déjalo vacío en local.
OPENAI_SECRET_ARN=
# Modelos (se definen al implementar el análisis, según precios vigentes).
OPENAI_TRANSCRIBE_MODEL=
OPENAI_ANALYSIS_MODEL=
# Límite de seguridad: minutos máximos de audio que se envían por video.
OPENAI_MAX_AUDIO_MINUTES_PER_VIDEO=180
